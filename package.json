{
  "name": "aurelia-storm-courier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An original offline flight game over the Lantern archipelago",
  "scripts": {
    "start": "node tools/serve-flight.mjs",
    "build": "node --import tsx main.ts",
    "test": "node --test tests/flight.test.mjs",
    "verify": "node --import tsx tools/verify-flight.mjs",
    "test:browser": "node tools/browser-flight.mjs",
    "capture": "node tools/browser-flight.mjs --capture"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright-core": "1.57.0",
    "tsx": "4.21.0"
  }
}
